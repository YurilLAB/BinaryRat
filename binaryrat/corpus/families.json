{
  "schema_version": 1,
  "split_rule": "sha256-of-id order, first half fit",
  "families": [
    {
      "id": "bzip2",
      "split": "fit",
      "language": "c",
      "license": "bzip2-1.0.6",
      "origin": {"archive": {
        "name": "bzip2-1.0.8.tar.gz",
        "url": "https://sourceware.org/pub/bzip2/bzip2-1.0.8.tar.gz",
        "sha256": "ab5a03176ee106d3f0fa90e381da478ddae405918153cca248e682cd0c4a2269",
        "prefix": "bzip2-1.0.8"}},
      "sources": ["blocksort.c", "huffman.c", "crctable.c", "randtable.c", "compress.c",
                  "decompress.c", "bzlib.c"],
      "flags": ["-std=gnu17"]
    },
    {
      "id": "expat",
      "split": "holdout",
      "language": "c",
      "license": "MIT",
      "origin": {"archive": {
        "name": "expat-2.7.1.tar.xz",
