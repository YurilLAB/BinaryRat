        "HAVE_STDINT_H=1", "HAVE_UNISTD_H=1", "HAVE_FCNTL_H=1", "HAVE_SYS_TIME_H=1",
        "HAVE_SYS_TYPES_H=1", "HAVE_SYS_STAT_H=1", "HAVE_SCHED_H=1", "HAVE_LOCALE_H=1",
        "HAVE_GETTIMEOFDAY=1", "HAVE_LOCALECONV=1", "HAVE_OPEN=1", "HAVE_CLOSE=1",
        "HAVE_READ=1", "HAVE_SCHED_YIELD=1", "HAVE_STRTOLL=1", "HAVE_SYNC_BUILTINS=1",
        "HAVE_ATOMIC_BUILTINS=1", "USE_URANDOM=1"]},
      "flags": ["-std=gnu17"]
    },
    {
      "id": "libtomcrypt",
      "split": "fit",
      "language": "c",
      "license": "Unlicense",
      "origin": {"archive": {
        "name": "crypt-1.18.2.tar.xz",
