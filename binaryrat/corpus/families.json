        "sha256": "354552544b8f99012e5062f7d570ec77f14b412a3ff5c7d8d0dae62c0d217c30",
        "prefix": "expat-2.7.1"}},
      "sources": ["lib/xmlparse.c", "lib/xmlrole.c", "lib/xmltok.c"],
      "include": ["lib"],
      "defines": ["XML_GE=1", "XML_DTD=1", "XML_NS=1", "XML_CONTEXT_BYTES=1024",
                  "XML_DEV_URANDOM=1", "HAVE_UNISTD_H=1", "HAVE_FCNTL_H=1"],
      "flags": ["-std=gnu17"]
    },
    {
      "id": "gnu-demangler",
      "split": "holdout",
      "language": "c",
      "license": "LGPL-2.1-or-later",
      "origin": {"repository": "GPL/DemanglerGnu/src/demangler_gnu_v2_41"},
      "sources": ["c/cp-demangle.c", "c/cplus-dem.c", "c/d-demangle.c", "c/rust-demangle.c",
                  "c/dyn-string.c", "c/safe-ctype.c", "c/xexit.c", "c/xstrdup.c", "c/argv.c",
                  "c/getopt.c", "c/getopt1.c"],
      "include": ["headers"],
      "defines": ["HAVE_STDLIB_H", "HAVE_STRING_H"],
      "flags": ["-std=gnu17"]
    },
    {
      "id": "jansson",
      "split": "holdout",
      "language": "c",
      "license": "MIT",
      "origin": {"archive": {
        "name": "jansson-2.14.1.tar.bz2",
